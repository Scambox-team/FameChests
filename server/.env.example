# Baza testowa: docker compose -f docker-compose.local.yml up -d db (z głównego folderu). Własna baza: wpisz jej adres.
# (baza z docker-compose.local.yml: użytkownik i hasło postgres, port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/scambox
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/scambox_test
# SECRET_KEY=...            (bez tego: DATA_DIR/secret_key.txt)
# DATA_DIR=..               (zdjęcia, klucz, kopie; domyślnie <folder gry>/data)
# METRICS_ADDR=127.0.0.1:9100
# OPERATOR_NAME=...         (kto prowadzi stronę - pokazuje się w regulaminie i polityce prywatności)
# CONTACT_EMAIL=...         (kontakt w regulaminie i polityce prywatności)
RUST_LOG=scambox=info
# zapytania sqlx::query! sprawdzane z .sqlx/ (bez bazy przy budowaniu); po zmianie zapytań: false + cargo sqlx prepare
SQLX_OFFLINE=true
