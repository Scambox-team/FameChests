# Skopiuj do .env i uzupelnij. Nowe wersje tego pliku tylko DODAJA pozycje - istniejacy .env dalej dziala.
CLOUDFLARED_TOKEN=
POSTGRES_PASSWORD=
GAME_SECRET_KEY=
OPERATOR_NAME=Operator SCAMBOX
CONTACT_EMAIL=
OWNER_IDS=
RUST_LOG=scambox=info
# Port gry w sieci lokalnej (domyslnie 5000)
SCAMBOX_LOCAL_PORT=5000
# Kopie bazy: co ile godzin (0 = wylaczone) i ile ostatnich trzymac
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
# Publiczny adres gry - BEZ koncowego "/". Wracaja tu linki z maili (weryfikacja, reset hasla).
GAME_PUBLIC_URL=https://scambox.pl
# Klucze GoTrue (konta z emailem) - wygeneruj: ./gen-auth-keys.sh (dopisuje tylko brakujace, nic nie nadpisuje).
# Sekret do podpisywania JWT (>= 32 znaki). Zmiana uniewazni SERVICE_ROLE_KEY i sesje.
JWT_SECRET=
# Klucz serwisowy dla gry (JWT HS256, role=service_role, podpisany JWT_SECRET)
SERVICE_ROLE_KEY=
# Haslo roli supabase_auth_admin w bazie (zmiana jest stosowana przy kolejnym `up` przez auth-init)
AUTH_DB_PASSWORD=
# true = konta bez potwierdzenia maila. TYLKO do testow! Na produkcji ma byc false.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_EMAIL_SIGNUP=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
# Opcjonalnie: pelny adres SMTP gry (np. smtps://user:haslo@host:465), ma pierwszenstwo przed SMTP_HOST/PORT/USER/PASS
SMTP_URL=
# Opcjonalnie: nadawca maili z gry
MAIL_FROM=
# Profile: discord = bot Discorda (usun "discord", jesli go nie uzywasz)
COMPOSE_PROFILES=tunnel,discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Haslo bota do gry (min. 16 znakow) - to samo po stronie gry i bota
DISCORD_BOT_GAME_TOKEN=
DISCORD_PING_ROLE_ID=
DISCORD_COMMANDS_ONLY=
# Webhook kanalu adminow na Discordzie: tam trafiaja zgloszenia kart (puste = wylaczone)
REPORTS_WEBHOOK_URL=
DISCORD_CH_ACCOUNTS=
DISCORD_CH_ONLINE=
DISCORD_CH_RANKING=
DISCORD_CH_QUESTS=
DISCORD_CH_EVENTS=
DISCORD_CH_CRATES=
DISCORD_CH_PATCH=
DISCORD_CH_DROPS=
DISCORD_CH_COMMANDS=
DISCORD_CH_ALERTS=
