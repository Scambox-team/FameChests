# Opcjonalne: skopiuj do .env (obok docker-compose.local.yml), żeby zmienić porty testu lokalnego.
# Plik .env nie trafia do repozytorium. Docker Compose czyta go sam.

# Port gry (http://localhost:8000).
SCAMBOX_PORT=8000

# Port Mailpit - podglądu maili wysyłanych przez grę (http://localhost:8025).
SCAMBOX_MAIL_PORT=8025

# Port testowej bazy PostgreSQL na localhost (do natywnego `cargo run`: DATABASE_URL=postgres://postgres:postgres@localhost:5433/scambox).
SCAMBOX_DB_PORT=5433
