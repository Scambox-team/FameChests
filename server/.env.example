# hasło: długie i losowe, to samo co POSTGRES_PASSWORD (patrz docker-compose.yml)
POSTGRES_PASSWORD=ZMIEN_NA_LOSOWE_HASLO
DATABASE_URL=postgres://postgres:ZMIEN_NA_LOSOWE_HASLO@localhost:5432/scambox
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/scambox_test
# SECRET_KEY=...            (bez tego: DATA_DIR/secret_key.txt)
# DATA_DIR=..               (zdjęcia i klucz; domyślnie folder gry)
# METRICS_ADDR=127.0.0.1:9100
# OPERATOR_NAME=...         (kto prowadzi stronę - pokazuje się w regulaminie i polityce prywatności)
# CONTACT_EMAIL=...         (kontakt w regulaminie i polityce prywatności)
# Powiadomienia e-mail o nowych zgłoszeniach kart (bez treści zgłoszenia, tylko numer i rodzaj); bez SMTP_HOST ich nie ma
# NOTIFY_EMAIL=...          (dokąd; domyślnie CONTACT_EMAIL)
# SMTP_HOST=smtp-relay.example.com
# SMTP_PORT=587             (587 = starttls, 465 = tls)
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=powiadomienia@twoja-domena.pl   (adres nadawcy zweryfikowany u dostawcy)
# SMTP_TLS=starttls         (starttls | tls | none - none tylko do testów lokalnych)
RUST_LOG=scambox=info
# zapytania sqlx::query! sprawdzane z .sqlx/ (bez bazy przy budowaniu); po zmianie zapytań: false + cargo sqlx prepare
SQLX_OFFLINE=true
